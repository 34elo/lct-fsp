# Скопируй в .env и замени значения CHANGE_ME. .env не коммитим.
ENV=dev                         # dev | demo | prod
COMPOSE_PROJECT_NAME=fsp
DOMAIN=fsp.patissons.tech
WEB_ORIGIN=https://dashboard.fsp.patissons.tech
API_ORIGIN=https://api.fsp.patissons.tech
GATEWAY_PORT=28080
DEMO_MODE=false
LOG_LEVEL=INFO
# Origin'ы SPA для CSRF-проверки cookie-эндпоинтов (JSON-список); префикс cookie `rt` за gateway
ALLOWED_ORIGINS=["https://dashboard.fsp.patissons.tech","https://fsp.patissons.tech","http://localhost:28080"]
# Origin кабинета для кнопок лендинга на корневом домене (прод: https://dashboard.fsp.patissons.tech); пусто — всё на одном origin
VITE_APP_URL=
AUTH_COOKIE_PATH=/api/v1/auth

# --- порты на хосте (диапазон 28xxx; RabbitMQ UI и Grafana только для Tailscale) ---
RABBITMQ_UI_PORT=28672
DOZZLE_PORT=28888

# --- postgres: суперпользователь и роли сервисов (базы core, fsp_connector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_pg_admin
CORE_DB_PASSWORD=CHANGE_ME_core_db
FSPC_DB_PASSWORD=CHANGE_ME_fspc_db
DATABASE_URL=postgresql+asyncpg://core:${CORE_DB_PASSWORD}@postgres:5432/core
FSP_CONNECTOR_DATABASE_URL=postgresql+asyncpg://fspc:${FSPC_DB_PASSWORD}@postgres:5432/fsp_connector

# --- redis ---
REDIS_URL=redis://redis:6379/0

# --- rabbitmq: vhost fsp, свой пользователь на сервис ---
RABBITMQ_ADMIN_USER=admin
RABBITMQ_ADMIN_PASSWORD=CHANGE_ME_rmq_admin
RABBITMQ_CORE_PASSWORD=CHANGE_ME_rmq_core
RABBITMQ_ML_PASSWORD=CHANGE_ME_rmq_ml
RABBITMQ_FSPC_PASSWORD=CHANGE_ME_rmq_fspc
RABBITMQ_BOT_PASSWORD=CHANGE_ME_rmq_bot
RABBITMQ_URL=amqp://core:${RABBITMQ_CORE_PASSWORD}@rabbitmq:5672/fsp

# --- minio / S3 ---
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://s3.fsp.patissons.tech
S3_ACCESS_KEY=fsp
S3_SECRET_KEY=CHANGE_ME_minio_secret
S3_BUCKET=fsp

# --- секреты приложения ---
JWT_SECRET=CHANGE_ME
PII_KEY=CHANGE_ME_fernet_key    # Fernet: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PSEUDO_ID_SECRET=CHANGE_ME
SERVICE_TOKEN_BOT=CHANGE_ME
SERVICE_TOKEN_ML=CHANGE_ME
SERVICE_TOKEN_CORE=CHANGE_ME     # токен core для internal API fsp-connector
SERVICE_TOKEN_MOCK=CHANGE_ME
CORE_URL=http://core-api:8000    # для ml и bot
ML_API_URL=http://ml-api:8100

# --- ФСП ---
FSP_CONNECTOR_URL=http://fsp-connector:8300
FSP_ADAPTER=mock                # mock | organizers | real
FSP_BASE_URL=http://fsp-mock:8200
FSP_PUBLIC_URL=https://mock.fsp.patissons.tech
FSP_OAUTH_REDIRECT_URI=https://api.fsp.patissons.tech/api/v1/auth/fsp/callback
FSP_API_KEY=CHANGE_ME
FSP_WEBHOOK_SECRET=CHANGE_ME
FSP_OAUTH_CLIENT_ID=platform
FSP_OAUTH_CLIENT_SECRET=CHANGE_ME

# --- Telegram ---
TG_BOT_TOKEN=                   # пусто — профиль bot не включается
TG_BOT_USERNAME=
WEB_BASE_URL=https://dashboard.${DOMAIN}   # адрес SPA для magic-ссылок из бота

# --- ML ---
LLM_PROFILE=gpu                 # gpu | cpu
LLM_BASE_URL=http://host.docker.internal:18090/v1
LLM_API_KEY=
LLM_MODEL=qwen3-vl-4b
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
GITHUB_TOKEN=
ML_FAKE=true

# --- аналитика и бейджи ---
ANALYTICS_SALT=CHANGE_ME
OB_SIGNING_KEY=
OB_ISSUER_DID=did:web:fsp.patissons.tech

# >>> block1 (assessment, taxonomy, identity, candidates, graph, resumes)
EMAIL_VERIFICATION_REQUIRED=false   # подтверждение email перед приглашением (blocks.md §4.6)
# Код подтверждения email: пустой SMTP_HOST — письма не отправляются; dev: SMTP_HOST=mailpit
# (профиль dev, письма в UI http://localhost:28025)
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@fsp-career.local
MAILPIT_UI_PORT=28025
LLM_ENABLED=true                    # false — профиль lite (make up-lite), ADR-023/024
EMBEDDING_MODEL=bge-m3              # lite: multilingual-e5-small (384 → добивается нулями до 1024)
EMBEDDING_MODEL_PATH=
# multilingual-e5-small скачивается с HF при первом старте ml-api в том hfcache (E44-1); пока не загрузилась — /healthz: fallback
EMBEDDING_HF_ID=                    # пусто → по имени модели; EMBEDDING_AUTOLOAD=false — без загрузки
# Майнинг мутаций (E30-3, make assessment-mutations-mine): 1 — качать архивы проектов с GitHub
# (токен — GITHUB_TOKEN, необязателен); 0 — только локальная копия (--dir). Кеш — MUTMINE_CACHE
MUTMINE_GITHUB=0
MUTMINE_CACHE=
# <<< block1
# >>> block2 (matching, offers, vacancies, companies, consents, fsp, telegram, analytics)
# <<< block2
