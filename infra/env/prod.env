# Конфигурация продового стенда (не секреты). infra/scripts/render-env.sh собирает .env стенда из трёх частей:
#   1) этот файл; 2) .env.server — внутренние секреты, создаются на сервере один раз (gen-server-secrets.sh);
#   3) внешние токены из окружения GitHub `prod` (TG_BOT_TOKEN, LLM_API_KEY, ALERT_*), их передаёт cd.yml.
ENV=prod
COMPOSE_PROJECT_NAME=fsp
DOMAIN=fsp.patissons.tech
WEB_ORIGIN=https://dashboard.fsp.patissons.tech
API_ORIGIN=https://api.fsp.patissons.tech
GATEWAY_PORT=28080
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["https://dashboard.fsp.patissons.tech","https://fsp.patissons.tech","http://localhost:28080"]
AUTH_COOKIE_PATH=/api/v1/auth
WEB_BASE_URL=https://dashboard.fsp.patissons.tech

# Демо для жюри: демо-аккаунты и обход кулдауна героев (E35-8), кнопки входа жюри на лендинге (сборка фронта)
DEMO_MODE=true
VITE_JURY_MODE=true

# S3: наружу через VPS
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://s3.fsp.patissons.tech
S3_ACCESS_KEY=fsp
S3_BUCKET=fsp

# ФСП: имитация API (реального API ФСП нет), страница входа мока на поддомене
FSP_ADAPTER=mock
FSP_BASE_URL=http://fsp-mock:8200
FSP_PUBLIC_URL=https://mock.fsp.patissons.tech
FSP_OAUTH_REDIRECT_URI=https://api.fsp.patissons.tech/api/v1/auth/fsp/callback
FSP_OAUTH_CLIENT_ID=platform

# ML: реальная LLM — общий llama-server на хосте (GPU), ключ — секрет LLM_API_KEY
ML_FAKE=false
LLM_ENABLED=true
LLM_PROFILE=gpu
LLM_BASE_URL=http://host.docker.internal:18090/v1
LLM_MODEL=qwen3-vl-4b
EMBEDDING_MODEL=bge-m3

# Почта не подключена: подтверждение email выключено
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=

OB_ISSUER_DID=did:web:fsp.patissons.tech

# Бэкапы (infra/scripts/backup.sh): каталог вне репозитория, хранение в днях
BACKUP_DIR=/home/elo/fsp-backups
BACKUP_KEEP_DAYS=7
