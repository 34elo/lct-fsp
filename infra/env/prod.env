# Конфигурация продового стенда (не секреты). infra/scripts/render-env.sh собирает .env стенда из трёх частей:
#   1) этот файл; 2) .env.server — внутренние секреты, создаются на сервере один раз (gen-server-secrets.sh);
#   3) токен бота платформы из окружения GitHub `prod` (TG_BOT_TOKEN, TG_BOT_USERNAME), их передаёт cd.yml.
# Ключ LLM и токен бота алертов уже лежат на сервере — render-env.sh и notify.sh берут их из файлов ниже.
ENV=prod
COMPOSE_PROJECT_NAME=fsp
DOMAIN=fsp.patissons.tech
WEB_ORIGIN=https://dashboard.fsp.patissons.tech
API_ORIGIN=https://api.fsp.patissons.tech
GATEWAY_PORT=28080
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["https://dashboard.fsp.patissons.tech","https://fsp.patissons.tech","http://localhost:28080"]
AUTH_COOKIE_PATH=/api/v1/auth
WEB_BASE_URL=https://dashboard.fsp.patissons.tech

# Демо для жюри: демо-аккаунты и обход кулдауна героев, кнопки входа жюри на лендинге (сборка фронта)
DEMO_MODE=true
REQUIRE_CANDIDATE_CONTACTS=true
VITE_JURY_MODE=true
VITE_APP_URL=https://dashboard.fsp.patissons.tech

# S3: наружу через VPS
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=https://s3.fsp.patissons.tech
S3_ACCESS_KEY=fsp
S3_BUCKET=fsp

# ФСП: имитация API (реального API ФСП нет), страница входа мока на поддомене
FSP_ADAPTER=mock
FSP_BASE_URL=http://fsp-mock:8200
FSP_PUBLIC_URL=https://mock.fsp.patissons.tech
FSP_OAUTH_REDIRECT_URI=https://api.fsp.patissons.tech/api/v1/auth/fsp/callback
FSP_OAUTH_CLIENT_ID=platform

# ML: реальная LLM — общий llama-server на хосте (GPU, 2 слота, делим с другим продом), ключ — строка
# LLM_API_KEY_LINE файла ключей сервера (~/hackathon-server-setup/llm/api-keys.txt)
LLM_API_KEY_FILE=/home/elo/hackathon-server-setup/llm/api-keys.txt
LLM_API_KEY_LINE=1
ML_FAKE=false
LLM_ENABLED=true
LLM_PROFILE=gpu
LLM_BASE_URL=http://host.docker.internal:18090/v1
LLM_MODEL=qwen3-vl-4b
EMBEDDING_MODEL=bge-m3

# Telegram с сервера напрямую недоступен: Bot API через ретранслятор на VPS, только в Tailscale (infra/vps/fsp.caddy)
TG_API_BASE=http://100.66.64.126:28443

# Алерты о деплоях — бот hostwatch (@patissons_alerts_bot): токен из его config.toml, чаты — подписчики из state.json
HOSTWATCH_DIR=/home/elo/everything/develop/hostwatch-bot

# Почта не подключена: подтверждение email выключено
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=

OB_ISSUER_DID=did:web:fsp.patissons.tech

# Бэкапы (infra/scripts/backup.sh): каталог вне репозитория, хранение в днях
BACKUP_DIR=/home/elo/fsp-backups
BACKUP_KEEP_DAYS=7
